# ==============================================================================
# Backend Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the production values.
# NEVER commit actual secrets into source control.
# ==============================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# PostgreSQL Database Connection
# In Docker Compose: postgresql://<user>:<password>@postgres:5432/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_STRONG_PASSWORD@postgres:5432/voice_orchestration?schema=public"

# Redis Cache & PubSub Connection
# In Docker Compose: redis://redis:6379 or redis://:password@redis:6379
REDIS_URL="redis://redis:6379"

# Security & Encryption (Mandatory: Used in src/utils/crypto.ts for AES-256-GCM credential encryption)
# Must be defined as ENCRYPTION_SECRET (64 hex characters / 32-byte key)
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="generate_a_secure_jwt_secret_64_characters_long"

# AI & Voice Provider API Keys (Optional if provided dynamically per-tenant)
OPENAI_API_KEY="sk-proj-your-openai-api-key"
DEEPGRAM_API_KEY="your-deepgram-api-key"

# Mediasoup WebRTC Infrastructure Configuration
# MEDIASOUP_LISTEN_IP should be 0.0.0.0 inside the container
MEDIASOUP_LISTEN_IP="0.0.0.0"
# MEDIASOUP_ANNOUNCED_IP MUST be set to your public Google Cloud VM External IP
MEDIASOUP_ANNOUNCED_IP="YOUR_GCE_STATIC_EXTERNAL_IP"
