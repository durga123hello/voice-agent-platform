# Server Settings
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/voice_agent_platform?schema=public"

# Redis Connection (or "memory" for local dev without Redis server)
REDIS_URL="redis://localhost:6379"

# Security Secrets
JWT_SECRET="your-jwt-secret-key-change-in-prod"
ENCRYPTION_SECRET="your-32-character-encryption-secret-key"

# AI Provider API Keys
DEEPGRAM_API_KEY="your_deepgram_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# SMTP Email Setup (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"

# Telephony Provider (Plivo / MSG91) (Optional)
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""
PLIVO_FROM_NUMBER=""
PLIVO_ANSWER_URL_BASE="http://localhost:3000"
