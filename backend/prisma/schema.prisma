datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  contactEmail  String?        @unique @map("contact_email")
  passwordHash  String?        @map("password_hash")
  emailVerified Boolean        @default(false) @map("email_verified")
  createdAt     DateTime?      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  members       TenantMember[]
  projects      Project[]
  users         User[]
  otpCodes          OtpCode[]
  integrationAgents IntegrationAgent[]
  teamMembers       TeamMember[]
  roles             Role[]
  permissions       Permission[]
  subscriptions     OrganizationSubscription[]

  @@map("tenants")
}

model User {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String?         @map("tenant_id") @db.Uuid
  email           String?         @unique
  officialEmail   String?         @unique @map("official_email")
  firstName       String?         @map("first_name")
  lastName        String?         @map("last_name")
  employeeId      String?         @map("employee_id")
  personalEmail   String?         @map("personal_email")
  phoneNumber     String?         @map("phone_number")
  dateOfBirth     String?         @map("date_of_birth")
  dateOfJoining   String?         @map("date_of_joining")
  nationality     String?         @map("nationality")
  gender          String?         @map("gender")
  role            String          @default("member") @map("role")
  status          String          @default("active") @map("status")
  profilePhotoUrl String?         @map("profile_photo_url")
  signatureUrl    String?         @map("signature_url")
  passwordHash    String?         @map("password_hash")
  managerId       String?         @map("manager_id") @db.Uuid
  createdAt       DateTime?       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager        User?           @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports        User[]          @relation("UserManager")
  memberships    TenantMember[]
  apiCredentials ApiCredential[]
  agentConfigs   AgentConfig[]

  @@index([tenantId])
  @@index([managerId])
  @@map("users")
}

model TenantMember {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  role      String    @default("member")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("organization_members")
}

model Project {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  tenantId     String        @map("tenant_id") @db.Uuid
  createdAt    DateTime?     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys      ApiKey[]
  agentConfigs AgentConfig[]
  sessions     Session[]

  @@map("projects")
}

model OtpCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  email     String
  codeHash  String   @map("code_hash")
  purpose   String   // 'signup' | 'login'
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

model ApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  keyHash    String    @map("key_hash")
  keyPrefix  String    @map("key_prefix")
  name       String?
  keyType    String    @default("private") @map("key_type") // 'private' | 'public'
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Provider {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    // 'deepgram' | 'openai'
  type      String    // 'stt' | 'tts' | 'llm'
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz

  @@map("providers")
}
model ApiCredential {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String    // 'deepgram' | 'openai'
  encryptedKey String    @map("encrypted_key")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("api_credentials")
}

model AgentConfig {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String               @map("project_id") @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  name      String?
  createdAt DateTime?            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime?            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  AgentConfigVersion[]

  @@map("agent_configs")
}

model AgentConfigVersion {
  id                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentConfigId            String      @map("agent_config_id") @db.Uuid
  version                  Int         @default(1)
  systemPrompt             String      @map("system_prompt")
  llmModel                 String      @map("llm_model") // 'gpt-4o' | 'gpt-4o-mini'
  voicePreference          String?     @map("voice_preference")
  jobDescription           String?     @map("job_description")
  candidateResume          String?     @map("candidate_resume")
  interviewPreferences     Json?       @map("interview_preferences")
  interviewDurationMinutes Int?        @map("interview_duration_minutes")
  uploadedQuestions        Json?       @map("uploaded_questions")
  behaviorSettings         Json?       @map("behavior_settings")
  firstMessage             String?     @map("first_message")
  transcriberConfig        Json?       @map("transcriber_config")
  recordingEnabled         Boolean     @default(false) @map("recording_enabled")
  silenceTimeoutSeconds    Int?        @map("silence_timeout_seconds")
  utteranceEndMs           Int?        @default(1800) @map("utterance_end_ms")
  analysisPlan             Json?       @map("analysis_plan")
  customContext            Json?       @map("custom_context")
  createdAt                DateTime?   @default(now()) @map("created_at") @db.Timestamptz
  agentConfig              AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  sessions                 Session[]

  @@map("agent_config_versions")
}

model Session {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String             @map("project_id") @db.Uuid
  agentConfigVersionId String             @map("agent_config_version_id") @db.Uuid
  status               String             @default("active") // 'active' | 'completed' | 'aborted'
  transport            String             @default("webrtc")
  phoneNumber          String?            @map("phone_number")
  startedAt            DateTime?          @default(now()) @map("started_at") @db.Timestamptz
  endedAt              DateTime?          @map("ended_at") @db.Timestamptz
  summary              String?

  // Production-ready lowercase tracking columns
  providerCallId       String?            @map("provider_call_id")
  callState            String             @default("initiating") @map("call_state")
  mediaState           String             @default("disconnected") @map("media_state")
  conversationState    String             @default("idle") @map("conversation_state")
  endedReason          String?            @map("ended_reason")
  errorCode            String?            @map("error_code")
  errorMessage         String?            @map("error_message")
  userMessage          String?            @map("user_message")
  recordingEnabled     Boolean            @default(false) @map("recording_enabled")
  recordingUrl         String?            @map("recording_url")
  lastActivityAt       DateTime           @default(now()) @updatedAt @map("last_activity_at") @db.Timestamptz

  project              Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentConfigVersion   AgentConfigVersion @relation(fields: [agentConfigVersionId], references: [id], onDelete: Cascade)
  messages             Message[]
  sessionEvents        SessionEvent[]

  @@map("sessions")
}

model Message {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  role      String    // 'user' | 'assistant' | 'system_event'
  content   String
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model SessionEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  eventType String    @map("event_type") // 'silence_prompt' | 'interruption' | 'utterance_end'
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  metadata  Json?
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_events")
}

model IntegrationAgent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  type           String    @map("type") // 'stt' | 'tts' | 'llm'
  name           String    @map("name")
  providerVendor String    @map("provider_vendor")
  status         String    @default("active") @map("status") // 'active' | 'restricted' | 'inactive' | 'review'
  config         Json      @default("{}") @map("config")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  llmSubscriptions OrganizationSubscription[] @relation("LlmSubscriptionAgent")
  sttSubscriptions OrganizationSubscription[] @relation("SttSubscriptionAgent")
  ttsSubscriptions OrganizationSubscription[] @relation("TtsSubscriptionAgent")

  @@unique([tenantId, type, name])
  @@index([tenantId, type])
  @@map("integration_agents")
}

model TeamMember {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  employeeId      String?   @map("employee_id")
  officialEmail   String?   @map("official_email")
  personalEmail   String?   @map("personal_email")
  phoneNumber     String?   @map("phone_number")
  dateOfBirth     String?   @map("date_of_birth")
  dateOfJoining   String?   @map("date_of_joining")
  nationality     String?   @map("nationality")
  gender          String?   @map("gender")
  role            String    @default("member") @map("role")
  status          String    @default("active") @map("status")
  projectAssigned String    @default("Both") @map("project_assigned") // 'vopx website' | 'voice orchestration platform' | 'Both'
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isDeleted])
  @@map("team_members")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String?          @map("tenant_id") @db.Uuid
  name            String           @map("name")
  description     String?          @map("description")
  isSystemRole    Boolean          @default(false) @map("is_system_role")
  createdAt       DateTime?        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String?          @map("tenant_id") @db.Uuid
  key                String           @map("key")
  label              String           @map("label")
  module             String           @map("module")
  action             String           @map("action")
  isSystemPermission Boolean          @default(false) @map("is_system_permission")
  createdAt          DateTime?        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions    RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime?  @default(now()) @map("created_at") @db.Timestamptz

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model SubscriptionPlan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  platformFee Decimal  @map("platform_fee") @db.Decimal(10, 2)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions OrganizationSubscription[]

  @@map("subscription_plans")
}

model OrganizationSubscription {
  id                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                      String   @map("tenant_id") @db.Uuid
  planId                        String   @map("plan_id") @db.Uuid
  llmAgentId                    String?  @map("llm_agent_id") @db.Uuid
  sttAgentId                    String?  @map("stt_agent_id") @db.Uuid
  ttsAgentId                    String?  @map("tts_agent_id") @db.Uuid
  estimatedInputTokensPerMonth  BigInt   @default(0) @map("estimated_input_tokens_per_month")
  estimatedOutputTokensPerMonth BigInt   @default(0) @map("estimated_output_tokens_per_month")
  estimatedSttMinutesPerMonth   Int      @default(0) @map("estimated_stt_minutes_per_month")
  estimatedTtsCharsPerMonth     BigInt   @default(0) @map("estimated_tts_chars_per_month")
  status                        String   @default("active") @map("status") // 'active' | 'pending' | 'cancelled'
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  llmAgent IntegrationAgent? @relation("LlmSubscriptionAgent", fields: [llmAgentId], references: [id], onDelete: SetNull)
  sttAgent IntegrationAgent? @relation("SttSubscriptionAgent", fields: [sttAgentId], references: [id], onDelete: SetNull)
  ttsAgent IntegrationAgent? @relation("TtsSubscriptionAgent", fields: [ttsAgentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("organization_subscriptions")
}




