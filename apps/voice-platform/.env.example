# ==============================================================================
# Frontend Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your domain values.
# ==============================================================================

# Node runtime environment
PORT=3001
NODE_ENV=production

# Public API and WebSocket URLs accessible by client browsers
# If using a custom domain with HTTPS/SSL:
NEXT_PUBLIC_API_URL="https://your-domain.com"
NEXT_PUBLIC_WS_URL="wss://your-domain.com"

# If testing with VM Public IP before SSL is configured:
# NEXT_PUBLIC_API_URL="http://34.120.45.67"
# NEXT_PUBLIC_WS_URL="ws://34.120.45.67"
